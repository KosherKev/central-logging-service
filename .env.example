PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/central-logging

# Legacy, migration-only: comma-separated flat keys, still accepted by
# apiKeyAuth's fallback for logs:read/logs:write/metrics:read (never
# metrics:write). New consumers should get a scoped key instead — see
# `npm run setup` or /admin/keys.html.
API_KEYS=dev-key-123,prod-key-456

# Bearer token guarding /admin/keys (key provisioning UI + API) — a
# separate, higher trust tier from the app-level keys above, since this
# surface can mint and revoke those. Generated by `npm run setup`.
ADMIN_SETUP_TOKEN=

# Google Cloud Storage — NOT CURRENTLY FUNCTIONAL. Cold-storage archival to
# GCS was designed early on and descoped the same day; the purge job only
# ever deletes from MongoDB, never uploads anywhere. These three vars are
# read nowhere in src/. Safe to leave unset — kept here as a placeholder in
# case archival gets built later, not because setting them does anything now.
GCS_BUCKET_NAME=your-logging-bucket
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Log Retention Configuration
HOT_STORAGE_DAYS=7
# NOT CURRENTLY FUNCTIONAL — parsed into config but never read anywhere
# (would only matter once/if cold storage above is actually built).
COLD_STORAGE_DAYS=90

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
